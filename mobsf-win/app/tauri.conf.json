{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MobSF-Win",
  "version": "0.1.0",
  "identifier": "com.mobsf.win",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MobSF-Win — Mobile Security Framework (Windows)",
        "width": 1080,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"]
  }
}
